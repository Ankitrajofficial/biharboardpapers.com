{
  "name": "bihar-board-padhai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run content:index && vite",
    "server": "node --experimental-strip-types server/index.ts",
    "dev:all": "npm run content:index && (npm run server & vite)",
    "build": "npm run content:check && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node --experimental-strip-types scripts/prerender.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "content:index": "node --experimental-strip-types scripts/content-index.ts",
    "content:syllabus": "node --experimental-strip-types scripts/import-syllabus.ts",
    "content:check": "node --experimental-strip-types scripts/content-check.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "node --experimental-strip-types scripts/lighthouse.ts"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
