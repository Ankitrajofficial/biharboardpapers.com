# ---- Frontend (Vite) ----
VITE_ANALYTICS_PROVIDER=none        # none | plausible | umami | cloudflare
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_SCRIPT=

# ---- Backend (server/) ----
PORT=8787
APP_ORIGIN=http://localhost:5173    # where the site is served (PayU return URLs and CORS)
API_ORIGIN=                         # public origin of this API if different from APP_ORIGIN
TEST_MODE=true                      # true: OTPs are returned in the API response; payments are simulated
SESSION_SECRET=change-me
# Admin panel owners (founder, co-founder). Editors are added from /admin/team.
ADMIN_OWNER_PHONES=91XXXXXXXXXX,91YYYYYYYYYY
REFUND_WINDOW_DAYS=7

# WhatsApp Business API (authentication template for OTP, utility template for receipts).
# Provider: meta (Cloud API) | msg91. Empty = console provider. There is no SMS or email OTP.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_SENDER=                    # phone-number id (Meta) or integrated number (MSG91)
WHATSAPP_AUTH_TEMPLATE=             # approved authentication template with copy-code button
WHATSAPP_UTILITY_TEMPLATE=          # approved utility template for receipts/reminders
# Optional email for receipts only
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# PayU (hosted checkout). The SALT never leaves the server.
PAYU_KEY=
PAYU_SALT=
PAYU_MODE=test                      # test | prod
