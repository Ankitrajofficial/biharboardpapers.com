{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node", "vite-plugin-pwa/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "@content/*": ["content/*"] }
  },
  "include": ["src", "scripts", "server", "tests", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
